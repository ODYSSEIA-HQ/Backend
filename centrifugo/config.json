{
	"http_server": {
		"address": "0.0.0.0",
		"port": 8000
	},
	"admin": {
		"enabled": true,
		"handler_prefix": "/centrifugo"
	},
	"engine": {
		"type": "memory"
	},
	"channel": {
		"max_length": 255
	},
	"client": {
		"insecure": false,
		"allowed_origins": [],
		"token": {
			"hmac_secret_key": ""
		}
	},
	"namespaces": [
		{
			"name": "topic",
			"presence": true,
			"join_leave": true,
			"history_size": 1000,
			"history_ttl": "3600s",
			"force_recovery": true,
			"allow_positioning": true,
			"allow_history_for_client": true,
			"subscribe_proxy_enabled": true,
			"subscribe_proxy_name": "bff"
		},
		{
			"name": "chat",
			"presence": true,
			"join_leave": false,
			"history_size": 200,
			"history_ttl": "3600s",
			"force_recovery": true,
			"allow_positioning": true,
			"allow_history_for_client": true,
			"subscribe_proxy_enabled": true,
			"subscribe_proxy_name": "bff"
		},
		{
			"name": "typing",
			"presence": true,
			"join_leave": false,
			"allow_publish_for_subscriber": true,
			"subscribe_proxy_enabled": true,
			"subscribe_proxy_name": "bff"
		},
		{
			"name": "user",
			"presence": false,
			"history_size": 50,
			"history_ttl": "86400s",
			"force_recovery": true,
			"allow_history_for_client": true,
			"subscribe_proxy_enabled": true,
			"subscribe_proxy_name": "bff"
		}
	],
	"proxies": [
		{
			"name": "bff",
			"endpoint": "http://bff:3000/centrifugo/subscribe",
			"timeout": "2s",
			"http": {
				"static_headers": {
					"x-odysseia-proxy": "${CENTRIFUGO_VAR_PROXY_SECRET}"
				}
			}
		}
	]
}
