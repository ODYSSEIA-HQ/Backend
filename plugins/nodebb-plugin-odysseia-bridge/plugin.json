{
  "id": "nodebb-plugin-odysseia-bridge",
  "library": "library.js",
  "acpTemplates": "acpTemplates",
  "scripts": [
    "static/lib/chat.js",
    "static/lib/decor.js"
  ],
  "css": [
    "static/lib/chat.css",
    "static/lib/decor.css"
  ],
  "hooks": [
    { "hook": "static:app.load", "method": "init" },
    { "hook": "action:post.save", "method": "onPostSave" },
    { "hook": "action:post.edit", "method": "onPostEdit" },
    { "hook": "action:post.delete", "method": "onPostDelete" },
    { "hook": "action:post.restore", "method": "onPostRestore" },
    { "hook": "action:posts.purge", "method": "onPostsPurge" },
    { "hook": "action:topics.purge", "method": "onTopicsPurge" },
    { "hook": "action:topic.delete", "method": "onTopicDelete" },
    { "hook": "action:topic.restore", "method": "onTopicRestore" },
    { "hook": "action:topic.edit", "method": "onTopicEdit" },
    { "hook": "filter:search.query", "method": "onSearchQuery" },
    { "hook": "filter:messaging.notify", "method": "onChatNotify" },
    { "hook": "filter:posts.getUserInfoForPosts", "method": "onUserInfoForPosts" },
    { "hook": "filter:helpers.getUserDataByUserSlug", "method": "onUserProfile" },
    { "hook": "action:group.update", "method": "onGroupUpdate" },
    { "hook": "action:group.rename", "method": "onGroupRename" },
    { "hook": "action:settings.set", "method": "onSettingsSet" },
    { "hook": "filter:admin.header.build", "method": "onAdminHeader" },
    { "hook": "filter:topic.post", "method": "onTopicPost" },
    { "hook": "filter:topic.reply", "method": "onTopicReply" },
    { "hook": "static:privileges.categories.init", "method": "onPrivilegesInit" },
    { "hook": "filter:topic.getPosts", "method": "onTopicGetPosts" },
    { "hook": "filter:messaging.getMessages", "method": "onMessagingGetMessages" }
  ]
}
