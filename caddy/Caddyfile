# ΟΔΥΣΣΕIA 反向代理
# 路由表：
#   /connection/*   → Centrifugo WS 客户端端点
#   /bff/*          → BFF 聚合层（token / 订阅代理回调 / 预签名 / 消息流）
#   其余            → NodeBB
# Centrifugo admin 面板不走公网：compose 将 127.0.0.1:4000 绑到宿主机，
# 需要 UI 时 ssh 端口转发访问 http://127.0.0.1:4000/centrifugo/admin/
{
	email admin@{$ODYSSEIA_DOMAIN}
	# 生产再开：servers { protocols h1 h2 h3 }
}

# 分类缓存位于各 worker 内存中：同一 URI 固定到同一 worker，
# 避免轮询导致 12 份冷缓存；其他路径仍轮询，防 /api/me 等热点集中。
(nodebb_cluster) {
	@categoryCache path /api/category/*
	reverse_proxy @categoryCache nodebb:4567 nodebb:4568 nodebb:4569 nodebb:4570 nodebb:4571 nodebb:4572 nodebb:4573 nodebb:4574 nodebb:4575 nodebb:4576 nodebb:4577 nodebb:4578 {
		lb_policy uri_hash
	}
	reverse_proxy nodebb:4567 nodebb:4568 nodebb:4569 nodebb:4570 nodebb:4571 nodebb:4572 nodebb:4573 nodebb:4574 nodebb:4575 nodebb:4576 nodebb:4577 nodebb:4578 {
		lb_policy round_robin
	}
}

{$ODYSSEIA_DOMAIN} {
	encode zstd gzip

	# 全站安全响应头（浏览器文档上下文用；WS/API 流量不受影响）
	# - HSTS：强制一年 HTTPS（纯 HTTP 的 dev 下浏览器会忽略此头，无害）
	# - 不加 preload：进 preload 列表近乎不可逆，需明确决策
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
	}

	# 隐私优先：关闭访问日志（安全设计 D10）
	# log { output discard }

	# --- Centrifugo ---
	@ws {
		path /connection/*
		header Connection *Upgrade*
		header Upgrade websocket
	}
	handle @ws {
		reverse_proxy centrifugo:8000
	}
	# --- BFF ---
	# 白名单公网路由：token / upload / vendor / healthz / chat 分页可经公网到达。
	# /bff/centrifugo/* 是 Centrifugo → BFF 的内网订阅回调（带共享密钥头），
	# 不对公网暴露——否则任何登录用户可伪造 body 探测他人频道权限（越权 oracle）。
	@bffPublic path /bff/token /bff/upload/* /bff/vendor/* /bff/healthz /bff/chat/*
	handle @bffPublic {
		uri strip_prefix /bff
		reverse_proxy bff:3000
	}

	# --- NodeBB（SSR 页面 + API + Socket.IO 后备通道） ---
	# cluster 12 worker 各占一个端口（4567-4578），必须全列，
	# 只写 4567 会把全部流量钉死在 worker#1（full-scale 实测：单 worker 饱和
	# CPU 114%/4worker，send p50 2.7s 纯排队；宿主 16 核，full5 剥冷启动后
	# 11.8 核满载，8 worker 仍不够 → 12 worker 吃满余量）
	handle {
		import nodebb_cluster
	}
}

# --- 内部 LB：分类 URI 亲和，其余请求 round_robin ---
# 仅 docker 网内可达（未映射宿主机端口），无 Host 门禁；
# 供 BFF（NODEBB_URL）与压测 k6（LT_HTTP_BASE）直打，分核 12 worker。
:8090 {
	import nodebb_cluster
}
