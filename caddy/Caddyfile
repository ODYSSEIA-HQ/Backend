# ΟΔΥΣΣΕIA 反向代理
# 路由表：
#   /connection/*   → Centrifugo WS 客户端端点
#   /bff/*          → BFF 聚合层（token / 订阅代理回调 / 预签名 / 消息流）
#   其余            → NodeBB
# Centrifugo admin 面板不走公网：compose 将 127.0.0.1:4000 绑到宿主机，
# 需要 UI 时 ssh 端口转发访问 http://127.0.0.1:4000/centrifugo/admin/

{
	email admin@{$ODYSSEIA_DOMAIN}
	# 生产再开：servers { protocols h1 h2 h3 }
}

{$ODYSSEIA_DOMAIN} {
	encode zstd gzip

	# 全站安全响应头（浏览器文档上下文用；WS/API 流量不受影响）
	# - HSTS：强制一年 HTTPS（纯 HTTP 的 dev 下浏览器会忽略此头，无害）
	# - 不加 preload：进 preload 列表近乎不可逆，需明确决策
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
	}

	# 隐私优先：关闭访问日志（安全设计 D10）
	# log { output discard }

	# --- Centrifugo ---
	@ws {
		path /connection/*
		header Connection *Upgrade*
		header Upgrade websocket
	}
	handle @ws {
		reverse_proxy centrifugo:8000
	}
	# --- BFF ---
	# 白名单公网路由：token / upload / vendor / healthz / chat 分页可经公网到达。
	# /bff/centrifugo/* 是 Centrifugo → BFF 的内网订阅回调（带共享密钥头），
	# 不对公网暴露——否则任何登录用户可伪造 body 探测他人频道权限（越权 oracle）。
	@bffPublic path /bff/token /bff/upload/* /bff/vendor/* /bff/healthz /bff/chat/*
	handle @bffPublic {
		uri strip_prefix /bff
		reverse_proxy bff:3000
	}

	# --- NodeBB（SSR 页面 + API + Socket.IO 后备通道） ---
	handle {
		reverse_proxy nodebb:4567
	}
}
