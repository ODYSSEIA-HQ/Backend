# ============ ΟΔΥΣΣΕΙΑ 环境变量 ============
# 复制为 .env 后填写；全部 changeme 必须替换！

# 对外域名（Caddy 用它签 TLS 证书）
ODYSSEIA_DOMAIN=odysseia.example.com

# ---- MongoDB ----
MONGO_INITDB_ROOT_USERNAME=odysseia
MONGO_INITDB_ROOT_PASSWORD=changeme
MONGO_INITDB_DATABASE=odysseia

# ---- Redis ----
REDIS_PASSWORD=changeme

# ---- NodeBB ----
# secret 由首装 setup 自动生成写入 config.json，无需手工配置
# 首装管理员（docker-compose.yml 用 :? 强制校验，缺失时 compose 直接报错）
NODEBB_ADMIN_USERNAME=admin
NODEBB_ADMIN_PASSWORD=changeme
NODEBB_ADMIN_EMAIL=admin@example.com
# 强制重装开关：留空=正常启动（config.json 缺失时自动首装）；置 1=强制 nodebb setup
NODEBB_SETUP=

# ---- Centrifugo ----
# 变量名与 Centrifugo v6 官方 env 规则一致：CENTRIFUGO_ + 大写配置路径（. → _）
# 生成方式：openssl rand -hex 32
CENTRIFUGO_CLIENT_TOKEN_HMAC_SECRET_KEY=changeme
CENTRIFUGO_HTTP_API_KEY=changeme
CENTRIFUGO_ADMIN_PASSWORD=changeme
# admin token 签名密钥（v6 要求与 password 同时设置）：openssl rand -hex 32
CENTRIFUGO_ADMIN_SECRET=changeme

# ---- 内部通信（BFF <-> NodeBB 插件） ----
ODYSSEIA_INTERNAL_TOKEN=changeme

# ---- 订阅代理共享密钥（Centrifugo -> BFF 订阅回调） ----
# 生成：openssl rand -hex 32；与 .env.example 其余 changeme 一样必须替换
ODYSSEIA_PROXY_SECRET=changeme

# ---- Meilisearch ----
MEILI_MASTER_KEY=changeme

# ---- Cloudflare R2 ----
# 对象存储：媒体桶 / R18 独立桶 / 备份桶
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_MEDIA=odysseia-media
R2_BUCKET_R18=odysseia-r18
R2_BUCKET_BACKUP=odysseia-backup

# ---- 备份加密（age 公钥） ----
# 生成：age-keygen -o key.txt（公钥填这里，私钥离线保存！）
BACKUP_AGE_PUBLIC_KEY=
